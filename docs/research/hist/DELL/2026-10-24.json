":0.1202,"chg52":1.8552,"mcap":290210381824.0},"key":{"mcap":290210381824.0,"ttm_eps":17.2,"ntm_eps":26.562,"tpe":26.5,"fpe":17.2,"peg":0.66,"ps":1.9,"gm":0.1991,"om":0.1202,"pm":0.0752,"roe":null,"cash":11569999872.0,"debt":35284000768.0,"dy":0.56,"beta":1.44,"hi52":595.51,"lo52":110.22,"chg52":1.8552,"ndx_pe":26.68,"e0":25.897,"e1":26.806,"g0":1.5142,"g1":0.0959,"rev0":193444314600.0,"rev1":229120787530.0,"rg0":0.70379996,"rg1":0.1844},"app_val":{"fpe":15.3,"tpe":26.5,"peg":0.66,"ps":1.9,"eg":2.729,"rg":0.577,"label":"偏平","why":"PEG 0.66（市盈率 ÷ 預期盈利增長；< 1 偏平、1–2 合理、2–3 偏貴、≥ 3 好貴）","vs_ndx":0.57,"src":"每日估值","at":"2026-10-24 09:25 HKT"},"fin":[{"end":"2022-01-28","rev":101197000000.0,"gp":21891000000.0,"op":4659000000.0,"ni":5563000000.0,"eps":null,"fcf":7511000000.0,"cfo":10307000000.0,"capex":2796000000.0,"sbc":1622000000.0,"buyback":1496000000.0,"div":0.0,"shares":791000000.0,"rev_g":0.16761278412368763},{"end":"2023-02-03","rev":102301000000.0,"gp":22686000000.0,"op":5771000000.0,"ni":2442000000.0,"eps":3.24,"fcf":562000000.0,"cfo":3565000000.0,"capex":3003000000.0,"sbc":931000000.0,"buyback":2883000000.0,"div":964000000.0,"shares":753000000.0,"rev_g":0.010909414310700916},{"end":"2024-02-02","rev":88425000000.0,"gp":21069000000.0,"op":5411000000.0,"ni":3388000000.0,"eps":4.6,"fcf":5920000000.0,"cfo":8676000000.0,"capex":2756000000.0,"sbc":878000000.0,"buyback":2080000000.0,"div":1072000000.0,"shares":736000000.0,"rev_g":-0.13563894781087182},{"end":"2025-01-31","rev":95567000000.0,"gp":21250000000.0,"op":6237000000.0,"ni":4592000000.0,"eps":6.38,"fcf":1869000000.0,"cfo":4521000000.0,"capex":2652000000.0,"sbc":785000000.0,"buyback":2588000000.0,"div":1275000000.0,"shares":720000000.0,"rev_g":0.08076901328809716},{"end":"2026-01-30","rev":113538000000.0,"gp":22707000000.0,"op":8149000000.0,"ni":5936000000.0,"eps":8.68,"fcf":8552000000.0,"cfo":11185000000.0,"capex":2633000000.0,"sbc":723000000.0,"buyback":6014000000.0,"div":1459000000.0,"shares":684000000.0,"rev_g":0.1880460828528676}],"ttm":{"rev":151197000000.0,"end":"2026-07-31","gp":29935000000.0,"op":14252000000.0,"ni":11378000000.0,"cfo":12152000000.0,"capex":3592000000.0,"sbc":727000000.0,"buyback":8518000000.0,"div":1566000000.0,"fcf":8560000000.0},"pe_hist":{"n":40,"med":15.2,"lo":5.0,"hi":48.3,"now":26.6,"since":"2021-10-31"},"checks":[{"label":"護城河寬","ok":false},{"label":"護城河強度 ≥ 8","ok":false},{"label":"確定性 ≥ 7","ok":false},{"label":"財務健康 ≥ 7","ok":false},{"label":"唔靠集資生存","ok":true,"why":"過去 4 季自由現金流 85.6 億；攤薄股數 3 年每年 -3.2%"}],"writing":{"verdict_plain":"DELL 現價 456.44，低過 Claude 公允價值 695.44 約 34%，評為 4 星（不確定性高）。AI 伺服器需求強勁，但估值已反映唔少利好，要留意競爭同成本壓力。","verdict_detail":"Claude 用三個情境計出公允價值 695.44，現價只係佢嘅 66%，所以有 34% 折讓，落入 4 星範圍（≤591.12）。不過不確定性高，因為 AI 需求可能降溫，bear 情境下今日價值得 216.86，比現價低 52.5%。Base 情境就值 557.00，比現價高 22%，而 bull 情境更誇張，值 1674.38，高 266.8%。加權後嘅 10 年後股價係 1551.01，即係每年約 13% 回報，但呢個假設 AI 增長持續。華爾街平均目標價 593.0，比現價高 30%，評級係買入，盈利預測亦上修，所以市場普遍樂觀。不過要留意，Dell 嘅護城河只係窄，財務健康評分得 6，確定性得 4，反映風險唔細。","conclusion":["Dell 嘅 AI 伺服器業務增長好快，收入同比升 146%，積壓訂單有 950 億美元，市佔率由 13% 升到 17%，傳統伺服器市佔率亦升到 29%。分析師平均目標價 593.0 美元，比現價高 30%，而且盈利預測喺 30 日內上修 8.7%，90 日內上修 43.6%，顯示市場對佢前景有信心。回購亦好積極，FY27 Q2 回購咗 43 億美元，有助減少攤薄。","不過風險都唔可以忽視。聯想嘅 x86 伺服器出貨量已經超越 Dell，價格戰可能加劇，令利潤率受壓。記憶體價格上升同供應緊張，亦可能侵蝕毛利率。另外，客戶集中風險高，依賴少數大型客戶如 NeoCloud，如果佢哋減少訂單，影響會好大。估值方面，股價比 GF Value 高 100.8%，反映市場已經計入好多利好。","最要盯嘅一件事係 AI 需求嘅可持續性。AI 伺服器需求可能受客戶資本開支週期影響，如果 AI 投資回報未達預期，訂單可能急跌。呢個係最大盲區，亦係不確定性高嘅主因。"],"changes":[],"valuation_plain":"Claude 用三個情境：bear（25%）、base（55%）、bull（20%），各自假設唔同增長率同第 10 年市盈率，折現率 9%，計出今日價值再按機率加權，得出公允價值 695.44。最大不確定係 AI 需求可持續性，如果需求降溫，價值可能大跌。","direction_up":["AI 伺服器需求持續強勁，積壓訂單進一步增加","市佔率繼續提升，盈利能力改善","分析師盈利預測繼續上修，市場情緒樂觀"],"direction_down":["AI 需求降溫，訂單減少，增長放緩","競爭加劇，價格戰令利潤率受壓","記憶體成本上升，侵蝕毛利率"],"holder_view":"已經持有嘅人，現價比公允價值低 34%，而且華爾街平均目標價 593.0，比現價高 30%，盈利預測亦上修，所以可以繼續觀察。不過要注意不確定性高，如果 AI 需求轉弱，股價可能大幅回調，要留意訂單同客戶資本開支嘅變化。","buyer_view":"未持有嘅人，現價 4 星，反映有一定折讓，但唔算好平。AI 增長故事吸引，但估值已反映唔少利好，而且競爭同成本壓力存在。如果相信 AI 需求持續，可以等更好嘅價位或者分批考慮，但要做好波動準備。","peer